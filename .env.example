# このファイルは「どんな環境変数が必要か」を示す見本です。実際の値は入れず、Gitに記録して構いません。
# 実際に使う値は .env.local に書いてください（.env.local はGitには記録されません）。

# Supabase Project Settings > Data API で確認できます
SUPABASE_URL=

# Supabase Project Settings > Data API の「Publishable key」（旧:anon key）
SUPABASE_ANON_KEY=

# Supabase Project Settings > Data API の「Secret key」（旧:service_role key）
# 絶対にブラウザ側のコードや公開リポジトリに含めないこと
SUPABASE_SERVICE_ROLE_KEY=

# AnthropicのAPIキー（Milestone 6で使用）
ANTHROPIC_API_KEY=
